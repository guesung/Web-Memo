{
	"$schema": "https://unpkg.com/syncpack/dist/schema.json",
	"formatRepository": false,
	"formatBugs": false,
	"indent": "\t",
	"versionGroups": [
		{
			"label": "Expo app uses different TypeScript, @types/react and tailwindcss versions",
			"packages": ["@web-memo/app"],
			"dependencies": ["typescript", "@types/react", "tailwindcss"],
			"isIgnored": true
		},
		{
			"label": "Peer dependency ranges of shared packages are intentionally wide",
			"dependencies": ["next"],
			"dependencyTypes": ["peer"],
			"isIgnored": true
		},
		{
			"label": "Sentry browser SDK must resolve to one version: captureException from a different copy than init is dropped silently (PR #528)",
			"dependencies": ["@sentry/react"],
			"preferVersion": "highestSemver"
		},
		{
			"label": "Use pinned versions for React core",
			"dependencies": ["react", "react-dom"],
			"dependencyTypes": ["!peer"],
			"pinVersion": "19.1.0"
		},
		{
			"label": "Use workspace protocol for internal packages",
			"dependencies": ["@web-memo/**", "@web-memo/**"],
			"dependencyTypes": ["!peer"],
			"pinVersion": "workspace:*"
		}
	]
}
