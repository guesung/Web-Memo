{
	"name": "@web-memo/api",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "tsc-watch -p tsconfig.build.json --onSuccess \"node dist/main.js\"",
		"build": "rm -rf dist && tsc -p tsconfig.build.json",
		"start": "node dist/main.js",
		"type-check": "tsc --noEmit",
		"test": "vitest run",
		"test:e2e": "vitest run --config vitest.config.e2e.ts"
	},
	"dependencies": {
		"@nestjs/common": "^12.6.0",
		"@nestjs/config": "^12.1.1",
		"@nestjs/core": "^12.6.0",
		"@nestjs/platform-express": "^12.6.0",
		"reflect-metadata": "^0.2.2",
		"rxjs": "^7.8.2"
	},
	"devDependencies": {
		"@nestjs/testing": "^12.6.0",
		"@swc/core": "^1.15.11",
		"@types/node": "^24.0.0",
		"@types/supertest": "^7.2.1",
		"supertest": "^7.3.2",
		"tsc-watch": "^6.2.1",
		"typescript": "5.5.3",
		"unplugin-swc": "^2.0.0",
		"vitest": "^2.1.5"
	}
}
