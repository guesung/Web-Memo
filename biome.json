{
	"$schema": "https://biomejs.dev/schemas/2.0.0/schema.json",
	"vcs": {
		"enabled": false,
		"clientKind": "git",
		"useIgnoreFile": false
	},
	"files": {
		"ignoreUnknown": false,
		"includes": [
			"**/src/**/*",
			"**/app/**/*",
			"!**/ios/**/*",
			"!**/android/**/*",
			"e2e/tests/**/*",
			"e2e/playwright.memo-performance.config.ts",
			"e2e/playwright.category-streaming.config.ts",
			"e2e/probes/category-streaming.spec.ts",
			"e2e/probes/category-streaming/**/*",
			"e2e/probes/memo-performance.spec.ts",
			"e2e/probes/memo-performance/**/*",
			"e2e/store-screenshots/**/*",
			"!e2e/store-screenshots/output/**",
			"!e2e/store-screenshots/.tmp/**",
			"!e2e/store-screenshots/assets/**",
			"!**/dist/**",
			"!**/node_modules/**",
			"!**/.next/**",
			"!**/.vercel/**",
			"!**/.expo/**",
			"!**/injected/highlightScript.ts",
			"!**/tailwind-output.css"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	},
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true,
			"complexity": {
				"noStaticOnlyClass": "off"
			},
			"style": {
				"noNonNullAssertion": "warn",
				"noRestrictedImports": {
					"level": "error",
					"options": {
						"paths": {
							"react-i18next": "useTranslation은 @src/modules/i18n/util.client(서버는 util.server)에서 가져옵니다. react-i18next의 첫 인자는 언어가 아니라 네임스페이스라, lng를 넘기면 그 이름의 네임스페이스를 따로 불러오느라 첫 렌더가 Suspense에 걸립니다."
						}
					}
				}
			},
			"suspicious": {
				"noArrayIndexKey": "warn",
				"noConfusingVoidType": "warn",
				"noDocumentCookie": "warn"
			}
		},
		"domains": {
			"react": "recommended"
		}
	},
	"overrides": [
		{
			"includes": ["apps/web/src/modules/i18n/**"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": "off"
					}
				}
			}
		}
	],
	"javascript": {
		"formatter": {
			"quoteStyle": "double"
		}
	},
	"assist": {
		"enabled": true,
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	}
}
