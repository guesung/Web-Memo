{
	servers {
		# Cloudflare 프록시를 거친 요청만 앞단 IP를 믿고, 실제 사용자 IP는 CF-Connecting-IP에서 꺼냅니다.
		# 이게 없으면 앱의 x-forwarded-for 첫 값이 Cloudflare 엣지 IP가 되어
		# rate limit이 모든 사용자를 한 사람으로 묶습니다.
		# 대역 목록은 compose.yaml의 CLOUDFLARE_IPS 한 곳에 있습니다(아래 접근 제한과 같이 씀)
		trusted_proxies static {$CLOUDFLARE_IPS}
		client_ip_headers CF-Connecting-IP X-Forwarded-For
	}
}

{$SITE_ADDRESS} {
	encode zstd gzip

	# Cloudflare를 거치지 않은 연결은 거절합니다. VM IP로 직접 붙으면 Cloudflare Access를 우회할 수 있기
	# 때문입니다(실제로 확인함). remote_ip는 TCP 상대 주소라 헤더로 속일 수 없습니다.
	# ACME HTTP-01 응답은 Caddy가 라우트보다 먼저 처리합니다.
	@not_cloudflare not remote_ip {$CLOUDFLARE_IPS}
	respond @not_cloudflare "Forbidden" 403

	# 접근 로그를 JSON으로 stdout에 남겨 Alloy가 Loki로 보냅니다. 앱이 죽어 Caddy가 낸 502·504도
	# status 필드로 잡혀 5xx 알림의 근거가 됩니다(Vercel 무료 플랜에서 못 받던 오류).
	# 헬스체크(/api/health)는 Caddy 내부 요청이라 여기 남지 않습니다.
	log {
		output stdout
		format json
	}

	# blue-green: 두 색을 모두 두고 /api/health가 200인 쪽으로만 보냅니다(활성 색이 아니면 503).
	# 전환은 state/color/active 파일만 바꾸고 이 설정은 다시 불러오지 않습니다.
	# caddy reload는 서버를 갈아끼우는 순간 들어온 요청을 끊기 때문입니다.
	reverse_proxy web-blue:3000 web-green:3000 {
		lb_policy first
		# 둘 다 아직 준비 전인 짧은 순간에는 실패하지 않고 기다립니다
		lb_try_duration 5s
		lb_try_interval 250ms
		health_uri /api/health
		health_interval 1s
		health_timeout 2s
		header_up X-Real-IP {client_ip}
	}
}
