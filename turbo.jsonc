{
	"$schema": "https://turbo.build/schema.json",
	"ui": "tui",

	// tsconfig.json 변경 시 모든 태스크 캐시 무효화
	"globalDependencies": ["tsconfig.json"],
	"globalPassThroughEnv": ["COREPACK_HOME"],

	// 패키지 경계 규칙: config → infra → library → app (하위 → 상위)
	"boundaries": {
		"tags": {
			"app": {
				"dependencies": { "deny": ["app"] }
			},
			"library": {
				"dependencies": { "deny": ["app"] }
			},
			"infra": {
				"dependencies": { "deny": ["app", "library"] }
			},
			"config": {
				"dependencies": { "deny": ["app", "library", "infra"] }
			}
		}
	},

	"tasks": {
		// 패키지 빌드 준비 (packages/dev-utils|env|hmr|zipper)
		"ready": {
			"dependsOn": ["^ready"],
			"inputs": ["$TURBO_DEFAULT$", "!**/*.md", "!**/*.test.*", "!**/*.spec.*"],
			"outputs": ["dist/**", "build/**"]
		},
		// 패키지 개발 모드 (apps/chrome-extension|web|app, pages/content-ui|options|side-panel, packages/hmr)
		"dev": {
			"dependsOn": ["^ready"],
			"persistent": true,
			"cache": false
		},
		// 패키지 미리보기 모드 (apps/web, packages/ui)
		"preview": {
			"persistent": true,
			"cache": false
		},

		// 프로덕션 빌드 (apps/app|chrome-extension|web, pages/content-ui|options|side-panel)
		"build": {
			"dependsOn": ["ready", "^build"],
			"inputs": ["$TURBO_DEFAULT$", "!**/*.md", "!**/*.test.*", "!**/*.spec.*", "!**/*.tsbuildinfo"],
			// turbo 2의 기본 envMode는 strict라, 선언하지 않으면 빌드가 셸의 BUILD_ENV를
			// 못 봅니다. next.config가 이 값으로 콘솔 제거 여부를 가르고, 캐시도 환경별로
			// 갈라져야 staging 산출물이 production 캐시를 물지 않습니다.
			// SENTRY_AUTH_TOKEN도 같은 이유로 선언합니다. 없으면 웹(Vercel)과 확장(cd-extension)
			// 빌드 모두 토큰을 못 받아 소스맵 업로드를 경고 한 줄만 남기고 건너뜁니다.
			// passThroughEnv가 아니라 env인 이유: 토큰 유무에 따라 산출물이 달라집니다(업로드 뒤
			// 소스맵 삭제). 토큰 없이 만든 CI 캐시를 배포 빌드가 재사용하면 업로드가 통째로 빠집니다.
			"env": ["BUILD_ENV", "SENTRY_AUTH_TOKEN"],
			"outputs": ["dist/**", "build/**", ".next/**", "!.next/cache/**"]
		},
		// 프로덕션 서버 실행 (apps/web)
		"start": {
			"dependsOn": ["build"],
			"persistent": true,
			"cache": false
		},

		// 익스텐션 패키징 (packages/zipper)
		"zip": {
			"dependsOn": ["^build"],
			// turbo 2의 기본 envMode는 strict라, 선언하지 않으면 zipper가 셸의 BUILD_ENV를
			// 못 봅니다. zip 파일 이름에 환경을 박는 데 씁니다.
			"env": ["BUILD_ENV"],
			"cache": false
		},

		// 코드 품질 (모든 패키지)
		"type-check": {
			"dependsOn": ["^ready"],
			"inputs": ["$TURBO_DEFAULT$", "!**/*.md", "!**/public/**"],
			"outputs": []
		},
		"lint": {
			"inputs": ["$TURBO_DEFAULT$", "!**/*.md", "!**/public/**"],
			"outputs": []
		},
		"lint:fix": {
			"cache": false
		},

		// 유틸리티
		"clean": {
			"cache": false
		},
		"tsc-watch": {
			"persistent": true,
			"cache": false
		}
	}
}
